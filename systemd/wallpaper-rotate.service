[Unit]
Description=Wissel de wallpaper en werk het pywal-kleurenschema bij
Documentation=https://github.com/simondewaal1980/qtile-rice

[Service]
Type=oneshot
# ~/.local/bin bevat 'wal' (pipx) en staat niet altijd in de systemd-PATH.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Alleen draaien als qtile actief is (dus niet in een Plasma-sessie).
ExecCondition=/usr/bin/pgrep -x qtile
# DISPLAY en XAUTHORITY erven we van de systemd-user-manager; die krijgt ze bij
# het inloggen van de sessie mee. Verandert er niets? Controleer dan
# 'systemctl --user show-environment' (daar moeten DISPLAY en XAUTHORITY in staan).
ExecStart=%h/.config/qtile/scripts/wallpaper-rotate.sh
